{
  "agent": "ccchat",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node /Users/awesome/dev/devtest/ccchat-improve/hooks/poll.js"
          },
          {
            "type": "command",
            "command": "node /Users/awesome/dev/devtest/ccchat-improve/hooks/empty-project.js"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node /Users/awesome/dev/devtest/ccchat-improve/hooks/stop.js"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node /Users/awesome/dev/devtest/ccchat-improve/hooks/leave.js"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node /Users/awesome/dev/devtest/ccchat-improve/hooks/notify.js"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node /Users/awesome/dev/devtest/ccchat-improve/hooks/start.js"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash /Users/awesome/dev/devtest/ccchat-improve/scripts/statusline.sh",
    "padding": 1
  },
  "permissions": {
    "allow": [
      "Bash(node /Users/awesome/dev/devtest/ccchat-improve/scripts/chat-send.js:*)",
      "Bash(node /Users/awesome/dev/devtest/ccchat-improve/scripts/chat-read.js:*)",
      "Bash(node /Users/awesome/dev/devtest/ccchat-improve/scripts/chat-ask.js:*)",
