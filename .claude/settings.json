      "Bash(node /Users/awesome/dev/devtest/ccchat-improve/scripts/chat-search.js:*)",
      "Bash(node /Users/awesome/dev/devtest/ccchat-improve/scripts/chat-join.js:*)",
      "Bash(node /Users/awesome/dev/devtest/ccchat-improve/scripts/chat-leave.js:*)",
      "Bash(node /Users/awesome/dev/devtest/ccchat-improve/scripts/chat-pin.js:*)",
      "Bash(node /Users/awesome/dev/devtest/ccchat-improve/scripts/chat-plan.js:*)",
      "Bash(node /Users/awesome/dev/devtest/ccchat-improve/scripts/chat-claim.js:*)",
      "Bash(node /Users/awesome/dev/devtest/ccchat-improve/scripts/chat-preclaim.js:*)",
      "Bash(node /Users/awesome/dev/devtest/ccchat-improve/scripts/chat-catchup.js:*)",
