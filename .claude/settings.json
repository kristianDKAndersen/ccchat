      "Bash(node /Users/awesome/dev/devtest/ccchat-improve/scripts/chat-consensus.js:*)",
      "Bash(node /Users/awesome/dev/devtest/ccchat-improve/scripts/chat-phase.js:*)",
      "Bash(node /Users/awesome/dev/devtest/ccchat-improve/scripts/chat-ui.js:*)",
      "Bash(node /Users/awesome/dev/devtest/ccchat-improve/scripts/chat-task-legacy.js:*)",
      "Bash(node /Users/awesome/dev/devtest/ccchat-improve/scripts/adr-logger.js:*)",
